{
    "version": "1.23.0",
    "description": "Julia version manager that installs, updates and switches Julia releases",
    "homepage": "https://github.com/JuliaLang/juliaup",
    "license": "MIT",
    "architecture": {
        "64bit": {
            "url": "https://github.com/JuliaLang/juliaup/releases/download/v1.23.0/juliaup-1.23.0-x86_64-unknown-linux-musl-portable.tar.gz",
            "hash": "5d5078d5ec5d92874e21122ffd9f4c36e42f913debbd73a560c55fce63c39a8a"
        },
        "arm64": {
            "url": "https://github.com/JuliaLang/juliaup/releases/download/v1.23.0/juliaup-1.23.0-aarch64-unknown-linux-musl-portable.tar.gz",
            "hash": "0f9f508eb1f9c5eab1646caa165d14139277bbe2cd8d2fab8d7ba5c00a6a54d5"
        }
    },
    "bin": [
        "juliaup",
        "julia"
    ],
    "checkver": {
        "github": "https://github.com/JuliaLang/juliaup",
        "regex": "^(?=(?<tag>.*)$)[vV]?(\\d+(?:\\.\\d+)*)$"
    },
    "autoupdate": {
        "architecture": {
            "64bit": {
                "url": "https://github.com/JuliaLang/juliaup/releases/download/$matchTag/juliaup-$version-x86_64-unknown-linux-musl-portable.tar.gz"
            },
            "arm64": {
                "url": "https://github.com/JuliaLang/juliaup/releases/download/$matchTag/juliaup-$version-aarch64-unknown-linux-musl-portable.tar.gz"
            }
        }
    }
}
