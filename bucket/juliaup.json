{
    "version": "1.24.0",
    "description": "Julia version manager that installs, updates and switches Julia releases",
    "homepage": "https://github.com/JuliaLang/juliaup",
    "license": "MIT",
    "architecture": {
        "64bit": {
            "url": "https://github.com/JuliaLang/juliaup/releases/download/v1.24.0/juliaup-1.24.0-x86_64-unknown-linux-musl-portable.tar.gz",
            "hash": "47c0335030513088311fc29ee1b6ae6bb2bef7b6a0aeb396da6663bd6adea795"
        },
        "arm64": {
            "url": "https://github.com/JuliaLang/juliaup/releases/download/v1.24.0/juliaup-1.24.0-aarch64-unknown-linux-musl-portable.tar.gz",
            "hash": "1175d1274ee41ddb82d1b6a81518ebd127408940bb130e6619b66e44db57431b"
        }
    },
    "bin": [
        "juliaup",
        "julia"
    ],
    "checkver": {
        "github": "https://github.com/JuliaLang/juliaup",
        "regex": "^(?=(?<tag>.*)$)[vV]?(\\d+(?:\\.\\d+)*)$"
    },
    "autoupdate": {
        "architecture": {
            "64bit": {
                "url": "https://github.com/JuliaLang/juliaup/releases/download/$matchTag/juliaup-$version-x86_64-unknown-linux-musl-portable.tar.gz"
            },
            "arm64": {
                "url": "https://github.com/JuliaLang/juliaup/releases/download/$matchTag/juliaup-$version-aarch64-unknown-linux-musl-portable.tar.gz"
            }
        }
    }
}
