{
    "version": "15.2.0",
    "description": "Recursive regex search that honors .gitignore",
    "homepage": "https://github.com/BurntSushi/ripgrep",
    "license": "Unlicense|MIT",
    "architecture": {
        "64bit": {
            "url": "https://github.com/BurntSushi/ripgrep/releases/download/15.2.0/ripgrep-15.2.0-x86_64-unknown-linux-musl.tar.gz",
            "hash": "33e15bcf1624b25cdd2a55813a47a2f95dbe126268203e76aa6a585d1e7b149c",
            "extract_dir": "ripgrep-15.2.0-x86_64-unknown-linux-musl"
        },
        "arm64": {
            "url": "https://github.com/BurntSushi/ripgrep/releases/download/15.2.0/ripgrep-15.2.0-aarch64-unknown-linux-gnu.tar.gz",
            "hash": "a740b91c82eaf9914cfedd353572f2791cbe0162c84101ee0951058f4dcbc90d",
            "extract_dir": "ripgrep-15.2.0-aarch64-unknown-linux-gnu"
        }
    },
    "bin": "rg",
    "checkver": {
        "github": "https://github.com/BurntSushi/ripgrep",
        "regex": "^(?=(?<tag>.*)$)[vV]?(\\d+(?:\\.\\d+)*)$"
    },
    "autoupdate": {
        "architecture": {
            "64bit": {
                "url": "https://github.com/BurntSushi/ripgrep/releases/download/$matchTag/ripgrep-$version-x86_64-unknown-linux-musl.tar.gz",
                "extract_dir": "ripgrep-$version-x86_64-unknown-linux-musl"
            },
            "arm64": {
                "url": "https://github.com/BurntSushi/ripgrep/releases/download/$matchTag/ripgrep-$version-aarch64-unknown-linux-gnu.tar.gz",
                "extract_dir": "ripgrep-$version-aarch64-unknown-linux-gnu"
            }
        },
        "hash": {
            "url": "$baseurl/$basename.sha256"
        }
    }
}
