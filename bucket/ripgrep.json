{
    "version": "16.0.0",
    "description": "Recursive regex search that honors .gitignore",
    "homepage": "https://github.com/BurntSushi/ripgrep",
    "license": "Unlicense|MIT",
    "architecture": {
        "64bit": {
            "url": "https://github.com/BurntSushi/ripgrep/releases/download/16.0.0/ripgrep-16.0.0-x86_64-unknown-linux-musl.tar.gz",
            "hash": "54268ab4643c00a290a29b0086066d64b3f56236dd805ec64629a86f9bd29fd0",
            "extract_dir": "ripgrep-16.0.0-x86_64-unknown-linux-musl"
        },
        "arm64": {
            "url": "https://github.com/BurntSushi/ripgrep/releases/download/16.0.0/ripgrep-16.0.0-aarch64-unknown-linux-gnu.tar.gz",
            "hash": "0b0bddcfaf42be1f3c56bf929d70defd1a2d96f2577aecbd7029a3734ddb4740",
            "extract_dir": "ripgrep-16.0.0-aarch64-unknown-linux-gnu"
        }
    },
    "bin": "rg",
    "checkver": {
        "github": "https://github.com/BurntSushi/ripgrep",
        "regex": "^(?=(?<tag>.*)$)[vV]?(\\d+(?:\\.\\d+)*)$"
    },
    "autoupdate": {
        "architecture": {
            "64bit": {
                "url": "https://github.com/BurntSushi/ripgrep/releases/download/$matchTag/ripgrep-$version-x86_64-unknown-linux-musl.tar.gz",
                "extract_dir": "ripgrep-$version-x86_64-unknown-linux-musl"
            },
            "arm64": {
                "url": "https://github.com/BurntSushi/ripgrep/releases/download/$matchTag/ripgrep-$version-aarch64-unknown-linux-gnu.tar.gz",
                "extract_dir": "ripgrep-$version-aarch64-unknown-linux-gnu"
            }
        },
        "hash": {
            "url": "$baseurl/$basename.sha256"
        }
    }
}
